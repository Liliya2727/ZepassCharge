#!/bin/sh
MODDIR=${0%/*}
bypassflag="/data/local/tmp/tempbypass"

# Function to write values to sysfs/proc files
apply() {
	if [ -f "$2" ]; then
		chmod 644 "$2" >/dev/null 2>&1
		echo "$1" >"$2" 2>/dev/null
		chmod 444 "$2" >/dev/null 2>&1
	fi
}


# Enable bypass charging with path detection
startBypass() {
    
        
    apply_if_exists() {
        if [ -e "$2" ]; then  # Check if the path exists
            apply "$1" "$2"
            return 0  # Stop execution if a valid path is found
        fi
        return 1
    }

	apply_if_exists "1" "/sys/class/power_supply/battery/batt_slate_mode" && return
	apply_if_exists "1" "/sys/class/power_supply/battery/battery_input_suspend" && return
	apply_if_exists "1" "/sys/class/power_supply/battery/bd_trickle_cnt" && return
	apply_if_exists "0" "/sys/class/power_supply/battery/device/Charging_Enable" && return
	apply_if_exists "0" "/sys/class/power_supply/battery/charging_enabled" && return
	apply_if_exists "1" "/sys/class/power_supply/battery/op_disable_charge" && return
	apply_if_exists "1" "/sys/class/power_supply/battery/store_mode" && return
	apply_if_exists "1" "/sys/class/power_supply/battery/test_mode" && return
	apply_if_exists "1" "/sys/class/power_supply/battery/battery_ext/smart_charging_interruption" && return
	apply_if_exists "0" "/sys/class/power_supply/battery/siop_level" && return
	apply_if_exists "0" "/sys/class/power_supply/battery/battery_charging_enabled" && return
	apply_if_exists "0" "/sys/class/power_supply/battery/mmi_charging_enable" && return
	apply_if_exists "1" "/sys/class/power_supply/battery/stop_charging_enable" && return
	apply_if_exists "1" "/sys/class/power_supply/battery/store_mode" && return
	apply_if_exists "0" "/sys/class/hw_power/charger/charge_data/enable_charger" && return
	apply_if_exists "1" "/sys/class/qcom-battery/input_suspend" && return
	apply_if_exists "1" "/sys/devices/platform/charger/bypass_charger" && return
	apply_if_exists "1" "/sys/devices/platform/charger/tran_aichg_disable_charger" && return
	apply_if_exists "0" "/sys/devices/platform/huawei_charger/enable_charger" && return
	apply_if_exists "1" "/sys/devices/platform/lge-unified-nodes/charging_completed" && return
	apply_if_exists "0" "/sys/devices/platform/lge-unified-nodes/charging_enable" && return
	apply_if_exists "1" "/sys/devices/platform/mt-battery/disable_charger" && return
	apply_if_exists "1" "/sys/devices/platform/soc/soc:google,charger/charge_disable" && return
	apply_if_exists "1" "/sys/kernel/debug/google_charger/chg_suspend" && return
	apply_if_exists "1" "/sys/kernel/debug/google_charger/input_suspend" && return
	apply_if_exists "on" "/sys/kernel/nubia_charge/charger_bypass" && return
	apply_if_exists "0 1" "/proc/mtk_battery_cmd/current_cmd" && return

    echo "No valid path found for bypass charging."
}

# Disable bypass charging with path detection
disableBypass() {
    apply_if_exists() {
        if [ -e "$2" ]; then  # Check if the path exists
            apply "$1" "$2"
            return 0  # Stop execution if a valid path is found
        fi
        return 1
    }

    # Apply values to disable bypass charging
    apply_if_exists "0" "/sys/class/power_supply/battery/batt_slate_mode" && return
    apply_if_exists "0" "/sys/class/power_supply/battery/battery_input_suspend" && return
    apply_if_exists "0" "/sys/class/power_supply/battery/bd_trickle_cnt" && return
    apply_if_exists "1" "/sys/class/power_supply/battery/device/Charging_Enable" && return
    apply_if_exists "1" "/sys/class/power_supply/battery/charging_enabled" && return
    apply_if_exists "0" "/sys/class/power_supply/battery/op_disable_charge" && return
    apply_if_exists "0" "/sys/class/power_supply/battery/store_mode" && return
    apply_if_exists "0" "/sys/class/power_supply/battery/test_mode" && return
    apply_if_exists "0" "/sys/class/power_supply/battery/battery_ext/smart_charging_interruption" && return
    apply_if_exists "1" "/sys/class/power_supply/battery/siop_level" && return
    apply_if_exists "1" "/sys/class/power_supply/battery/battery_charging_enabled" && return
    apply_if_exists "1" "/sys/class/power_supply/battery/mmi_charging_enable" && return
    apply_if_exists "0" "/sys/class/power_supply/battery/stop_charging_enable" && return
    apply_if_exists "0" "/sys/class/power_supply/battery/store_mode" && return
    apply_if_exists "1" "/sys/class/hw_power/charger/charge_data/enable_charger" && return
    apply_if_exists "0" "/sys/class/qcom-battery/input_suspend" && return
    apply_if_exists "0" "/sys/devices/platform/charger/bypass_charger" && return
    apply_if_exists "0" "/sys/devices/platform/charger/tran_aichg_disable_charger" && return
    apply_if_exists "1" "/sys/devices/platform/huawei_charger/enable_charger" && return
    apply_if_exists "0" "/sys/devices/platform/lge-unified-nodes/charging_completed" && return
    apply_if_exists "1" "/sys/devices/platform/lge-unified-nodes/charging_enable" && return
    apply_if_exists "0" "/sys/devices/platform/mt-battery/disable_charger" && return
    apply_if_exists "0" "/sys/devices/platform/soc/soc:google,charger/charge_disable" && return
    apply_if_exists "0" "/sys/kernel/debug/google_charger/chg_suspend" && return
    apply_if_exists "0" "/sys/kernel/debug/google_charger/input_suspend" && return
    apply_if_exists "off" "/sys/kernel/nubia_charge/charger_bypass" && return
    apply_if_exists "0 0" "/proc/mtk_battery_cmd/current_cmd" && return

    echo "No valid path found to disable bypass charging."
}

# apply mode based on game detection
apply_mode() {
	# Ensure cur_mode is initialized
	if [ -z "$cur_mode" ]; then
		export cur_mode=0
	fi
	if [ "$1" -eq 1 ] && [ "$cur_mode" -ne 1 ]; then
		export cur_mode=1
		/system/bin/am start -a android.intent.action.MAIN -e toasttext "Bypass charging applied!" -n bellavita.toast/.MainActivity
		sleep 1
		startBypass	
elif [ "$1" -eq 0 ] && [ "$cur_mode" -ne 0 ]; then
		export cur_mode=0
		/system/bin/am start -a android.intent.action.MAIN -e toasttext "Bypass charging disabled!" -n bellavita.toast/.MainActivity
		sleep 1
		disableBypass
	fi
}

# Monitoring function
monitoring() {
	while true; do
		if [ ! -f "$bypassflag" ]; then		
			apply_mode 1 # Enable Bypass Charge
		else
			apply_mode 0 # Disable Bypass Charge
		fi
		sleep 2 # Adjust sleep duration as needed
	done
}

monitoring &

